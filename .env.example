NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
WEB_ORIGIN=http://localhost:4200

# Authentication: replace both secrets with independent random values before production.
AUTH_ACCESS_SECRET=local-only-access-secret-change-before-production-2026
AUTH_TOKEN_PEPPER=local-only-token-pepper-change-before-production-2026
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_RESET_TTL_SECONDS=1800
AUTH_COOKIE_SECURE=false
DATABASE_URL=postgresql://tranhanh:tranhanh@localhost:5432/tranhanh?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SEO: leave indexing disabled until a public HTTPS origin is explicitly configured.
PUBLIC_SITE_URL=
PUBLIC_ALLOW_INDEXING=false

# Server-only API origin for phone SSR and the same-origin browser gateway.
API_ORIGIN=http://127.0.0.1:3000
