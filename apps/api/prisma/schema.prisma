generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  vi
  en
}

enum ProviderStatus {
  ACTIVE
  DEGRADED
  DISABLED
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Publisher/origin identity; credentials belong in secret management.
model DataSource {
  id           String                  @id @default(uuid()) @db.Uuid
  key          String                  @unique @db.VarChar(100)
  name         String                  @db.VarChar(250)
  homepageUrl  String?                 @db.VarChar(2048)
  dataUrl      String?                 @db.VarChar(2048)
  termsUrl     String?                 @db.VarChar(2048)
  isOfficial   Boolean                 @default(false)
  isActive     Boolean                 @default(false)
  createdAt    DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(3)
  translations DataSourceTranslation[]
  providers    DataProvider[]
  references   SourceReference[]
}

/// Persisted source notes only; official names and UI dictionaries stay separate.
model DataSourceTranslation {
  id           String     @id @default(uuid()) @db.Uuid
  sourceId     String     @db.Uuid
  locale       Locale
  description  String?    @db.Text
  licenseNotes String?    @db.Text
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  source       DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sourceId, locale])
}

/// Adapter identity, distinct from its publisher. No credentials or arbitrary config JSON.
model DataProvider {
  id                   String         @id @default(uuid()) @db.Uuid
  key                  String         @unique @db.VarChar(100)
  name                 String         @db.VarChar(250)
  sourceId             String         @db.Uuid
  providerType         String         @db.VarChar(100)
  status               ProviderStatus @default(DISABLED)
  lastSuccessfulSyncAt DateTime?      @db.Timestamptz(3)
  lastFailedSyncAt     DateTime?      @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)
  source               DataSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  syncRuns             SyncRun[]

  @@index([sourceId])
  @@index([status])
}

/// Migration CHECK constraints enforce counts and completion times.
/// Counts represent committed work on success. Failure messages must be sanitized.
model SyncRun {
  id             String       @id @default(uuid()) @db.Uuid
  providerId     String       @db.Uuid
  jobType        String       @db.VarChar(100)
  status         SyncStatus   @default(RUNNING)
  startedAt      DateTime     @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?    @db.Timestamptz(3)
  recordsRead    Int?
  recordsCreated Int?
  recordsUpdated Int?
  recordsSkipped Int?
  errorCode      String?      @db.VarChar(100)
  errorMessage   String?      @db.VarChar(1000)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  provider       DataProvider @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([providerId, startedAt(sort: Desc), id])
  @@index([status, startedAt])
}

/// Migration CHECK enforces [effectiveFrom, effectiveTo).
/// Evidence shared by future domain rows via explicit foreign keys, never entityType/entityId.
model SourceReference {
  id                            String                          @id @default(uuid()) @db.Uuid
  sourceId                      String                          @db.Uuid
  externalUrl                   String?                         @db.VarChar(2048)
  publishedAt                   DateTime?                       @db.Timestamptz(3)
  retrievedAt                   DateTime                        @db.Timestamptz(3)
  effectiveFrom                 DateTime?                       @db.Timestamptz(3)
  effectiveTo                   DateTime?                       @db.Timestamptz(3)
  notes                         String?                         @db.VarChar(2000)
  createdAt                     DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime                        @updatedAt @db.Timestamptz(3)
  title                         String?                         @db.VarChar(500)
  areaCodes                     AreaCode[]
  areaMigrations                AreaCodeMigration[]
  telecomLocalities             TelecomLocality[]
  telecomGroups                 TelecomLocalityGroup[]
  operators                     TelecomOperator[]
  phonePrefixes                 PhonePrefix[]
  phoneMigrations               PhonePrefixMigration[]
  vehiclePlateTargets           VehiclePlateTarget[]
  vehiclePlateAllocations       VehiclePlateAllocation[]
  vehiclePlateHistorySources    VehiclePlateAllocationHistory[] @relation("VehiclePlateHistorySource")
  vehiclePlateTransitionSources VehiclePlateAllocationHistory[] @relation("VehiclePlateTransitionSource")
  postalTargets                 PostalCodeTarget[]
  postalAssignments             PostalCodeAssignment[]
  source                        DataSource                      @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([sourceId, retrievedAt(sort: Desc)])
}

/// Explicit page identity. Future domains reference this row with a typed, optional unique FK.
model SeoPage {
  id        String        @id @default(uuid()) @db.Uuid
  key       String        @unique @db.VarChar(150)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  metadata  SeoMetadata[]
}

/// Migration CHECK requires a normalized path matching locale.
/// Optional overrides; canonical paths are relative to the configured public origin.
model SeoMetadata {
  id                  String   @id @default(uuid()) @db.Uuid
  pageId              String   @db.Uuid
  locale              Locale
  canonicalPath       String   @db.VarChar(500)
  titleOverride       String?  @db.VarChar(250)
  descriptionOverride String?  @db.VarChar(1000)
  noindexOverride     Boolean?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  page                SeoPage  @relation(fields: [pageId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([pageId, locale])
  @@unique([canonicalPath])
}

enum PhonePrefixStatus {
  ACTIVE
  LEGACY
  INACTIVE
}

model TelecomOperator {
  id                String          @id @default(uuid()) @db.Uuid
  key               String          @unique @db.VarChar(100)
  name              String          @db.VarChar(250)
  searchName        String          @db.VarChar(500)
  website           String?         @db.VarChar(2048)
  isActive          Boolean         @default(true)
  sourceReferenceId String          @db.Uuid
  sourceReference   SourceReference @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  prefixes          PhonePrefix[]

  @@index([sourceReferenceId])
}

model PhonePrefix {
  id                String                 @id @default(uuid()) @db.Uuid
  prefix            String                 @unique @db.VarChar(4)
  operatorId        String                 @db.Uuid
  operator          TelecomOperator        @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status            PhonePrefixStatus
  effectiveFrom     DateTime?              @db.Timestamptz(3)
  effectiveTo       DateTime?              @db.Timestamptz(3)
  sourceReferenceId String                 @db.Uuid
  sourceReference   SourceReference        @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  importedAt        DateTime               @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  replacement       PhonePrefixMigration?  @relation("OldPrefix")
  previous          PhonePrefixMigration[] @relation("NewPrefix")

  @@index([operatorId, status, prefix])
  @@index([status, prefix])
  @@index([sourceReferenceId])
}

model PhonePrefixMigration {
  id                String          @id @default(uuid()) @db.Uuid
  oldPrefixId       String          @unique @db.Uuid
  newPrefixId       String          @db.Uuid
  oldPrefix         PhonePrefix     @relation("OldPrefix", fields: [oldPrefixId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  newPrefix         PhonePrefix     @relation("NewPrefix", fields: [newPrefixId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  effectiveAt       DateTime?       @db.Timestamptz(3)
  sourceReferenceId String          @db.Uuid
  sourceReference   SourceReference @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  @@index([newPrefixId])
  @@index([sourceReferenceId])
}

enum AreaCodeStatus {
  ACTIVE
  LEGACY
  INACTIVE
}

/// A reviewed telecom grouping, not an administrative unit or an administrative hierarchy.
model TelecomLocalityGroup {
  id                String            @id @default(uuid()) @db.Uuid
  key               String            @unique @db.VarChar(100)
  name              String            @db.VarChar(250)
  aliases           String[]
  searchName        String            @db.VarChar(1000)
  effectiveFrom     DateTime?         @db.Date
  sourceReferenceId String            @db.Uuid
  sourceReference   SourceReference   @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  localities        TelecomLocality[]
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  @@index([sourceReferenceId])
}

/// Stable telephone service area. The name reflects source-era coverage, not immutable province boundaries.
model TelecomLocality {
  id                String               @id @default(uuid()) @db.Uuid
  key               String               @unique @db.VarChar(100)
  name              String               @db.VarChar(250)
  aliases           String[]
  searchName        String               @db.VarChar(1000)
  isActive          Boolean              @default(true)
  groupId           String               @db.Uuid
  group             TelecomLocalityGroup @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceReferenceId String               @db.Uuid
  sourceReference   SourceReference      @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  codes             AreaCode[]
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)

  @@index([groupId])
  @@index([sourceReferenceId])
}

model AreaCode {
  id                String              @id @default(uuid()) @db.Uuid
  code              String              @unique @db.VarChar(4)
  localityId        String              @db.Uuid
  locality          TelecomLocality     @relation(fields: [localityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status            AreaCodeStatus
  effectiveFrom     DateTime?           @db.Date
  effectiveTo       DateTime?           @db.Date
  sourceReferenceId String              @db.Uuid
  sourceReference   SourceReference     @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  importedAt        DateTime            @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  replacement       AreaCodeMigration?  @relation("OldAreaCode")
  previous          AreaCodeMigration[] @relation("NewAreaCode")

  @@index([localityId, status, code])
  @@index([status, code])
  @@index([sourceReferenceId])
}

model AreaCodeMigration {
  id                String          @id @default(uuid()) @db.Uuid
  oldCodeId         String          @unique @db.Uuid
  newCodeId         String          @db.Uuid
  oldCode           AreaCode        @relation("OldAreaCode", fields: [oldCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  newCode           AreaCode        @relation("NewAreaCode", fields: [newCodeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Start of the transition, not necessarily the end of parallel dialing.
  effectiveDate     DateTime?       @db.Date
  sourceReferenceId String          @db.Uuid
  sourceReference   SourceReference @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  @@index([newCodeId])
  @@index([sourceReferenceId])
}

enum VehiclePlateTargetType {
  LOCALITY
  CENTRAL_AUTHORITY
}

enum VehiclePlateAllocationStatus {
  ACTIVE
  INACTIVE
}

/// A source-backed vehicle-registration allocation target, separate from an administrative hierarchy.
model VehiclePlateTarget {
  id                String                          @id @default(uuid()) @db.Uuid
  key               String                          @unique @db.VarChar(100)
  name              String                          @db.VarChar(250)
  aliases           String[]
  searchName        String                          @db.VarChar(1000)
  type              VehiclePlateTargetType
  isActive          Boolean                         @default(true)
  sourceReferenceId String                          @db.Uuid
  sourceReference   SourceReference                 @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  allocations       VehiclePlateAllocation[]
  previousHistory   VehiclePlateAllocationHistory[]
  createdAt         DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                        @updatedAt @db.Timestamptz(3)

  @@index([type, isActive, name])
  @@index([sourceReferenceId])
}

/// Public allocation only. No submitted full plate, vehicle, owner, or registration record is stored.
model VehiclePlateAllocation {
  id                String                          @id @default(uuid()) @db.Uuid
  key               String                          @unique @db.VarChar(100)
  numericPrefix     String                          @db.VarChar(2)
  seriesPrefix      String?                         @db.VarChar(2)
  targetId          String                          @db.Uuid
  target            VehiclePlateTarget              @relation(fields: [targetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status            VehiclePlateAllocationStatus
  effectiveFrom     DateTime?                       @db.Date
  effectiveTo       DateTime?                       @db.Date
  sourceReferenceId String                          @db.Uuid
  sourceReference   SourceReference                 @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  importedAt        DateTime                        @db.Timestamptz(3)
  history           VehiclePlateAllocationHistory[]
  createdAt         DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                        @updatedAt @db.Timestamptz(3)

  @@index([numericPrefix, status, seriesPrefix])
  @@index([targetId, status, numericPrefix])
  @@index([sourceReferenceId])
}

/// Prior allocation target and official transition evidence; this does not invalidate existing issued plates.
model VehiclePlateAllocationHistory {
  id                    String                 @id @default(uuid()) @db.Uuid
  allocationId          String                 @db.Uuid
  allocation            VehiclePlateAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousTargetId      String                 @db.Uuid
  previousTarget        VehiclePlateTarget     @relation(fields: [previousTargetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  effectiveFrom         DateTime?              @db.Date
  effectiveTo           DateTime               @db.Date
  sourceReferenceId     String                 @db.Uuid
  sourceReference       SourceReference        @relation("VehiclePlateHistorySource", fields: [sourceReferenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transitionReferenceId String                 @db.Uuid
  transitionReference   SourceReference        @relation("VehiclePlateTransitionSource", fields: [transitionReferenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)

  @@unique([allocationId, previousTargetId, effectiveTo])
  @@index([previousTargetId, effectiveTo])
  @@index([sourceReferenceId])
  @@index([transitionReferenceId])
}

enum PostalCodeTargetType {
  PROVINCE_CITY
  WARD
  COMMUNE
  SPECIAL_ZONE
}

enum PostalCodeStatus {
  ACTIVE
  INACTIVE
}

/// Minimal source-backed postal hierarchy; it is not the canonical administrative domain.
model PostalCodeTarget {
  id                String                 @id @default(uuid()) @db.Uuid
  key               String                 @unique @db.VarChar(100)
  name              String                 @db.VarChar(250)
  aliases           String[]
  searchName        String                 @db.VarChar(1000)
  type              PostalCodeTargetType
  parentId          String?                @db.Uuid
  parent            PostalCodeTarget?      @relation("PostalTargetHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children          PostalCodeTarget[]     @relation("PostalTargetHierarchy")
  isActive          Boolean                @default(true)
  sourceReferenceId String                 @db.Uuid
  sourceReference   SourceReference        @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignments       PostalCodeAssignment[]
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)

  @@index([parentId, type, isActive, name])
  @@index([searchName])
  @@index([sourceReferenceId])
}

model PostalCodeAssignment {
  id                String           @id @default(uuid()) @db.Uuid
  key               String           @unique @db.VarChar(100)
  code              String           @db.VarChar(5)
  targetId          String           @db.Uuid
  target            PostalCodeTarget @relation(fields: [targetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status            PostalCodeStatus
  effectiveFrom     DateTime?        @db.Date
  effectiveTo       DateTime?        @db.Date
  sourceReferenceId String           @db.Uuid
  sourceReference   SourceReference  @relation(fields: [sourceReferenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  importedAt        DateTime         @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([code, targetId])
  @@index([code, status])
  @@index([targetId, status, code])
  @@index([sourceReferenceId])
}

enum AccountStatus {
  ACTIVE
  DISABLED
  PENDING_DELETION
}

enum VehicleType {
  CAR
  MOTORCYCLE
  TRUCK
  VAN
  OTHER
}

enum VehicleStatus {
  ACTIVE
  ARCHIVED
}

/// Private account identity. Password hashes and account data never enter public lookup/SEO models.
model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(320)
  passwordHash        String               @db.VarChar(255)
  displayName         String?              @db.VarChar(100)
  status              AccountStatus        @default(ACTIVE)
  lastLoginAt         DateTime?            @db.Timestamptz(3)
  passwordChangedAt   DateTime?            @db.Timestamptz(3)
  deletionRequestedAt DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  vehicles            Vehicle[]

  @@index([status, createdAt])
}

/// Private vehicle record. Every application query must include userId ownership.
model Vehicle {
  id                     String        @id @default(uuid()) @db.Uuid
  userId                 String        @db.Uuid
  displayName            String        @db.VarChar(100)
  licensePlate           String        @db.VarChar(20)
  normalizedLicensePlate String        @db.VarChar(20)
  vehicleType            VehicleType
  make                   String?       @db.VarChar(100)
  model                  String?       @db.VarChar(100)
  modelYear              Int?          @db.SmallInt
  currentOdometerKm      Int?
  notes                  String?       @db.VarChar(1000)
  isPrimary              Boolean       @default(false)
  status                 VehicleStatus @default(ACTIVE)
  archivedAt             DateTime?     @db.Timestamptz(3)
  createdAt              DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(3)
  user                   User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, normalizedLicensePlate])
  @@index([userId, status, isPrimary, createdAt(sort: Desc)])
}

/// Server-side refresh session. Only keyed hashes are stored; raw refresh/CSRF values live in secure client state.
model AuthSession {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @db.Uuid
  familyId            String       @db.Uuid
  tokenHash           String       @unique @db.Char(64)
  csrfTokenHash       String       @db.Char(64)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  expiresAt           DateTime     @db.Timestamptz(3)
  lastUsedAt          DateTime?    @db.Timestamptz(3)
  revokedAt           DateTime?    @db.Timestamptz(3)
  replacedBySessionId String?      @unique @db.Uuid
  user                User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacedBy          AuthSession? @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  replaces            AuthSession? @relation("SessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

/// One-time password reset capability. Delivery receives the raw token; persistence keeps only its keyed hash.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
}
